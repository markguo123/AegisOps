# AegisOps 安装配置（install.sh 的唯一配置文件，也是生产安装的唯一必改文件）
# 用法：
#   cp deploy/install.env.example install.env   # 放到源码目录之外更安全，如 ~/.aegisops/deploy/
#   vi install.env                               # 只需要改这一个文件
#   bash deploy/install.sh --env-file install.env --yes
# 本文件不会作为 shell 执行：不支持命令替换、export 或内联注释，只允许 KEY=VALUE。
# 优先级：CLI（--KEY=VALUE）> 已导出的环境变量 > 本文件 > 内置默认。
# 原生 Helm 用户不需要本文件：直接改 deploy/helm/aegisops/values.yaml。
# 含凭据时 chmod 600，并放在源码目录之外，不要提交 Git。

# ---- 安装形态 ----
# 安装档位：production（外部 MySQL + S3）或 quickstart（体验，SQLite + 本地文件）
PROFILE=production
# 生产镜像仓库路径；脚本从当前源码构建并推送到节点可达仓库
IMAGE=registry.example.com/aegisops
# 固定版本号；同一版本不要覆盖已推送的镜像
TAG=v1.0.0
# 形态：standard（Web + Backend 分离）/ minimal（内嵌 SPA 单镜像）
FORM=standard
# Kubernetes 命名空间
NAMESPACE=aegisops
# 是否从源码构建镜像（已有 CI 镜像时设 false）
BUILD=true
# 是否把构建出的镜像推到 IMAGE 仓库；远程/多节点集群必须 true
PUSH=true

# ---- 数据库（MySQL）----
STORE_DRIVER=mysql
# 二选一：
#   MYSQL_DSN    —— 由脚本创建 <release>-mysql Secret（键 dsn，必须含 parseTime=true）
#   MYSQL_SECRET —— 引用你已创建好的 Secret 名（同样需 dsn 键）
#MYSQL_DSN='aegisops:password@tcp(mysql:3306)/aegisops?parseTime=true&charset=utf8mb4&timeout=10s&readTimeout=30s&writeTimeout=30s'
#MYSQL_SECRET=aegisops-mysql
# 可选：DDL 迁移专用 Secret（与运行账号分离时填写）
#MIGRATION_SECRET=aegisops-dbmigration-secret

# ---- 对象存储（S3 兼容）----
BLOBS_BACKEND=s3
# 二选一：
#   BLOBS_*      —— 由脚本创建 <release>-s3 Secret
#   BLOBS_SECRET —— 引用你已创建好的 Secret 名（AEGISOPS_PLATFORM_BLOBS_* 环境变量键）
#BLOBS_ENDPOINT=s3.internal:9000
#BLOBS_REGION=us-east-1
#BLOBS_BUCKET=aegisops
#BLOBS_ACCESS_KEY=your-access-key
#BLOBS_SECRET_KEY=your-secret-key
#BLOBS_USE_TLS=true
#BLOBS_PATH_STYLE=true
#BLOBS_CREATE_BUCKET=false
#BLOBS_SECRET=aegisops-s3

# ---- 持久化与访问方式 ----
# 是否用 PVC 持久化报告（false 退化为 emptyDir）
PERSIST_REPORTS=true
# 存储类：留空 = 省略 storageClassName，走集群默认存储类
#STORAGE_CLASS=standard
#REPORT_STORAGE_SIZE=5Gi
#DATA_STORAGE_SIZE=5Gi
# 暴露方式：nodeport / ingress / none（none = 仅集群内 ClusterIP，前置代理或 Ingress 另行配置）
EXPOSE=none
# 对外访问根地址（HTTPS 反向代理场景必填）
#PUBLIC_URL=https://aegisops.internal
# 填了就启用 Ingress（Kubernetes Ingress 入口）
#INGRESS_HOST=aegisops.internal
#INGRESS_CLASS=nginx
# 已有 TLS Secret 名（Ingress 用）
#INGRESS_TLS_SECRET=aegisops-tls

# ---- 镜像拉取 ----
# 私有仓库的 imagePullSecret 名
#IMAGE_PULL_SECRET=registry-auth
#IMAGE_PULL_POLICY=IfNotPresent

# ---- 权限与身份认证 ----
# 是否开启写操作与人工审批链路
#ENABLE_WRITE=false
# 是否允许体验模式的 HTTP 登录（生产保持 false）
#ALLOW_QUICKSTART_HTTP=false
# OIDC 自定义 CA 文件（脚本会注入为 Secret）
#OIDC_CA_FILE=/secure/idp-ca.pem
#OIDC_DISABLE_PKCE=false
#OIDC_ALLOW_MISSING_NONCE=false

# ---- 构建源加速（可选）----
# Go 模块代理；国内/内网填 https://goproxy.cn,direct，气隙现场改用内网 GOPROXY
#GOPROXY=https://goproxy.cn,direct
# npm 依赖源；国内/内网填 https://registry.npmmirror.com
#NPM_REGISTRY=https://registry.npmmirror.com
# 内置 kubectl 版本与下载 mirror 根路径（目录结构需与 dl.k8s.io/release 一致）
#KUBECTL_VERSION=v1.29.15
#KUBECTL_DOWNLOAD_BASE=https://files.m.daocloud.io/dl.k8s.io/release
# 重复构建加速：BuildKit 本机层缓存；docker 驱动自动降级为内联缓存（不支持本地目录导出）
#CACHE_BUILD=true

# 完整参数和 values 字段见部署手册。旧 --rotate/LOAD_TAR/ENABLE_MINIO 等不再支持；
# 使用用户管理的 Secret 轮换凭据、节点运行时导入镜像、官方中间件安装流程。
