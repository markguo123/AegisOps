# 生产安装使用此变量文件；快速体验零参数安装不需要配置文件。
PROFILE=production
FORM=standard
#ALLOW_QUICKSTART_HTTP=false  # 仅快速体验 HTTP 登录；生产默认关闭
#RELEASE_REPOSITORY=markguo123/AegisOps
# AegisOps 四期一键安装参数模板（P6.4）
#
# 用法：
#   cp deploy/install.env.example install.env
#   vi install.env            # 只改需要改的行，其余保持注释即用内置默认
#   chmod 600 install.env     # 可能含口令与密钥，权限收紧，且不要提交进 Git
#   deploy/install.sh --env-file install.env --dry-run   # 先预演
#   deploy/install.sh --env-file install.env             # 再真装
#
# 反复发布/升级建议走 deploy/upgrade.sh：把本文件放 ~/.aegisops/deploy/install.env（与源码目录解耦，
# 发布记录与日志一并落那里），TAG 可只写发布号前缀，脚本会按 git 派生成 <TAG>-<短 sha>；
# 正式发版加 --follow-env-tag 用固定 TAG。口径见 docs/03-运维与部署/01-部署与安装.md §4.11。
#
# 规则：
#   1. 每行一个 KEY=VALUE；行首 # 是注释，注释掉的行等于「不设置，用脚本内置默认」。
#   2. 优先级：命令行 --KEY=VALUE > 导出的环境变量 > 本文件 > 脚本内置默认。
#   3. 值可以带成对引号（DSN 这类含特殊字符的推荐加单引号），脚本会去掉引号。
#   4. 下面给的都是占位示例，照抄必然装不上：镜像仓库、域名、存储类、DSN 由现场决定。

# --- 镜像与构建 --------------------------------------------------------------
# 后端镜像地址，不含标签（★必填）。脚本不会内置任何真实仓库地址。
#IMAGE=registry.internal/platform/aegisops
# 镜像标签（★必填），例 4.0.0
#TAG=4.0.0
# 前端镜像地址，不含标签。仅 FORM=separated（前后端分离）必填。
#IMAGE_WEB=registry.internal/platform/aegisops-web
# 是否由脚本构建镜像。探测不到 docker/podman 时自动降级为「只发布不构建」。
#BUILD=false
# 构建后是否推送镜像仓库。集群拉不到本地镜像时必须 true。
#PUSH=false
# 离线交付：从 docker save 产出的 tar 导入镜像并跳过构建，填 tar 路径。
#LOAD_TAR=
# 拉取策略：IfNotPresent（内网常用）/ Always。
#IMAGE_PULL_POLICY=IfNotPresent
# 私有仓库拉取凭据。两种写法：集群里已存在的 Secret 名，或 dockerconfigjson 文件路径
# （给了文件路径脚本会自建名为 aegisops-registry 的 Secret）。HTTP 仓库还需要节点
# containerd 配好 insecure，见 docs/03-运维与部署/01-部署与安装.md。
#IMAGE_PULL_SECRET=
# 构建用 Go 代理。留空则读 ~/.aegisops/goproxy.txt，再退回内置默认。
#GOPROXY=https://goproxy.internal,direct
#GOPROXY=https://goproxy.cn,direct
# 内置进镜像的 kubectl 版本；留空 = 不内置 kubectl（保留 shell 工具层）。
#KUBECTL_VERSION=v1.28.13
# kubectl 下载基址，目录结构需与 dl.k8s.io/release 一致。纯内网改成内网 mirror，
# 或者把二进制放进 deploy/kubectl/ 走离线投递（优先于下载）。
#KUBECTL_DOWNLOAD_BASE=https://files.m.daocloud.io/dl.k8s.io/release

# --- 发布形态 ----------------------------------------------------------------
# 部署形态：allinone（形态 A，一体化镜像，默认）/ separated（形态 B，前后端分离）
#FORM=allinone
# 命名空间，默认 aegisops。改名会把全部清单里的命名空间引用一起改写。
#NAMESPACE=aegisops
# 对外暴露方式：nodeport（默认，无需域名）/ ingress / none（只做集群内访问）。
#EXPOSE=nodeport
# NodePort 端口号。留空 = 由集群随机分配（脚本会回读实际端口并打印访问地址）。
#NODE_PORT=30080
# Ingress 域名。EXPOSE=ingress 时必填；用自定义域名时客户端需要配 hosts 解析。
#INGRESS_HOST=aegisops.internal.example
# IngressClass 名字。留空用 nginx；先 kubectl get ingressclass 确认现场类名。
#INGRESS_CLASS=
# 浏览器实际访问的 HTTPS 根地址（无尾斜杠），OIDC 回调固定为该地址 + /api/v1/auth/oidc/callback。
# 需要 TLS 终止代理/Ingress；仅有 HTTP NodePort 时登录 Cookie 不可用。
#PUBLIC_URL=https://aegisops.internal.example
# 企业登录（OIDC）的服务端根 CA：IdP 用集群/公司内部自建 CA 签发证书时必填，否则页面配企业
# 登录会报 OIDC discovery failed: x509 certificate signed by unknown authority（证书是内网 CA
# 签的，镜像里的系统信任链不认）。值是宿主机上的 PEM 文件路径，内容以
# -----BEGIN CERTIFICATE----- 开头。脚本把它写进 aegisops-config，并把
# platform.auth.oidc_ca_file 渲染成容器内的 /etc/aegisops/oidc-ca.crt。
# 这只是给平台自己追加信任根，不改 IdP 所在环境的任何东西；公钥不是机密，所以走 ConfigMap。
# 从 IdP 侧取 CA（密钥里的 ca.crt 一般是 base64，记得解码）：
#   kubectl -n <idp-ns> get secret <idp-secret> -o jsonpath='{.data.ca\.crt}' | base64 -d > idp-ca.crt
# 另外别忘了在 IdP 的客户端配置里登记回调地址 <PUBLIC_URL>/api/v1/auth/oidc/callback，
# 这一步按 OAuth2 协议必须在 IdP 侧做，平台改不了。
#OIDC_CA_FILE=./idp-ca.crt
# 企业 IdP 的 PKCE 实现有问题时才置 true：true 时授权请求不带 code_challenge、令牌交换不带 code_verifier。
# 默认留空即 false。判据是 IdP 在 discovery 里声称支持 PKCE、实际却不保存 code_challenge（部分 Dex
# 分支如此），表现为单点登录每次都在令牌交换那一步被拒，报 invalid_request。关掉 PKCE 会削弱授权码
# 被截获后的防线，正常 IdP（Keycloak、正版 Dex、Azure AD、企业微信等）一律不要开。
#OIDC_DISABLE_PKCE=true

# 企业 IdP 收到 nonce 却不回传时才置 true：true 时容忍 id_token 完全没有 nonce 声明。
# 默认留空即 false。判据是授权请求明明带了 nonce，IdP 却不持久化（部分 Dex 分支如此，其自定义登录页还会把
# nonce 从 back 参数里丢掉），签发的 id_token 因此永远没有 nonce，表现为单点登录每次都报
# id token nonce does not match this login（服务端日志 reason=id-token-rejected）。放宽面只有「完全没有
# nonce 声明」这一种，IdP 回了 nonce 却对不上仍然拒绝，且放行时要求 id_token 的 iat 不早于本次登录事务开始。
# 这会削弱一次性随机数的防重放强度，正常 IdP（Keycloak、正版 Dex、Azure AD、企业微信等）一律不要开。
#OIDC_ALLOW_MISSING_NONCE=true

# --- 业务存储 ----------------------------------------------------------------
# 存储驱动：mysql（主口径）/ sqlite（单机兜底，数据必须落 PVC）。
#STORE_DRIVER=mysql
# MySQL DSN，STORE_DRIVER=mysql 时必填。只写进 Secret/aegisops-store，绝不进 ConfigMap。
# 库与账号需 DBA 预建，建议 utf8mb4。
#MYSQL_DSN='user:pass@tcp(db.internal:3306)/aegisops?charset=utf8mb4&parseTime=true'
# SQLite 库文件路径（落在 PVC 上），仅 STORE_DRIVER=sqlite 生效。
#SQLITE_PATH=/data/aegisops.db
# 是否创建数据 PVC。生产默认 true；false 时 /data 和 /reports 用临时卷，Pod 重建丢失。
#PERSIST_REPORTS=true
# StorageClass 名字。留空 = 用集群默认存储类（无默认存储类会拒绝并打印可选列表）。
#STORAGE_CLASS=
# 报告 PVC 容量。
#REPORT_STORAGE_SIZE=5Gi

# --- 对象存储（会话附件 / 大对象，P8）----------------------------------------
# 后端：db（默认，存 MySQL，零外部依赖）/ dir（本地目录，单副本）/ s3（S3 兼容）。
#BLOBS_BACKEND=db
# S3 兼容端点，host:port 形式。driver=s3 必填。
#BLOBS_ENDPOINT=s3.internal:9000
# 桶名。driver=s3 必填。
#BLOBS_BUCKET=aegisops
# 访问密钥 ID。driver=s3 必填，只落 Secret/aegisops-blobs。
#BLOBS_ACCESS_KEY=
# 访问密钥 Secret。driver=s3 必填，只落 Secret/aegisops-blobs，不进清单明文。
#BLOBS_SECRET_KEY=
# 区域名，S3 签名用；MinIO 常见填 us-east-1。
#BLOBS_REGION=us-east-1
# 是否启用 TLS。自建 MinIO 走 HTTP 时填 false。
#BLOBS_USE_TLS=false
# 是否用路径风格寻址（http://host/bucket/key）。自建 MinIO 通常 true。
#BLOBS_PATH_STYLE=true
# 桶不存在时是否自动创建。默认 false：生产桶由平台组预建并配好生命周期，运行账号不给建桶
# 权限。启动期建桶会把「桶名写错 / 凭据没权限」放大成整个服务起不来，而聊天、审批、审计一个
# 字节都不需要对象存储；桶不可达时对象类 API 回 503，/readyz 不受影响。
#BLOBS_CREATE_BUCKET=false
# driver=s3 的上传中转目录（先落盘算 sha256 再上传）。留空用配置默认 /tmp/aegisops-blobs；
# 给了值必须是绝对路径，且落在可写卷挂载点之下（镜像根文件系统只读）。
#BLOBS_TMP_DIR=
# 对象 key 前缀，多套环境共用一个桶时用来隔离。留空不注入。
#BLOBS_PREFIX=
# 是否由本脚本一并部署 MinIO。自带 MinIO 清单随 P8.8 交付，当前开启会被拒绝，
# 请先用 BLOBS_BACKEND=s3 对接现场已有的 MinIO / 任意 S3 兼容存储。
#ENABLE_MINIO=false
# 自带 MinIO 的存储卷容量（随 P8.8 生效）。
#MINIO_STORAGE_SIZE=20Gi
# 容器内跑 blobs/db 这类碰库命令必须带 --config /etc/aegisops/config.yaml：不带就回落到默认
# sqlite（一个全新空库），报 platform schema is at version 0，那是假象而不是真库状态。
# 换对象后端时是否跳过迁移闸门。默认 false：server 只装配一个内容后端，直接改 driver 会让旧
# 后端里的历史对象读不到，正确路径是先 blobs migrate 再 blobs verify --strict。闸门会先进 server
# 容器数旧后端还剩多少对象——一个都没有（空库首次切后端）就直接放行，不必动这个开关。
#ALLOW_DRIVER_MISMATCH=false

# --- 密钥与首启账号 ----------------------------------------------------------
# 敏感值加密主密钥，64 位 hex（32 字节，openssl rand -hex 32 生成）。留空 = 复用集群
# 已有 Secret，没有则随机生成并在 ENC_KEY_BACKUP_DIR 下留 600 权限备份。轮换只走 --rotate。
#ENC_KEY=
# ENC_KEY 本地备份目录。本文件不做变量展开，请写绝对路径。
#ENC_KEY_BACKUP_DIR=/root/.aegisops/keys
# 首启管理员用户名，留空用程序默认。
#ADMIN_USERNAME=
# 首启管理员口令。留空 = 随机生成且只在本次终端输出打印一次，脚本不二次回显。
#ADMIN_PASSWORD=
# 模型 API Key，写进 Secret/aegisops-llm 供首次启动兜底；日常改密钥请直接在配置中心页面做。
#LLM_API_KEY=

# --- 权限与超时 --------------------------------------------------------------
# 是否额外下发写权限 RBAC（deploy/rbac-write.example.yaml）。true 会二次确认。
# 关掉时 Agent 只能读，写操作会被集群 RBAC 拒绝。
#ENABLE_WRITE=false
# 各阶段等待超时（秒）：PVC Binding、迁移 Job、滚动升级。
#WAIT_TIMEOUT=300
