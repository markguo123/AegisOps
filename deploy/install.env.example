# 兼容变量文件：推荐新生产部署使用 Helm values + 已有 Secret。
# 本文件不会作为 shell 执行；不支持命令替换、export 或内联注释。
# 优先级：CLI > 已导出的环境变量 > 本文件。敏感值不要写在命令行。
PROFILE=production
# 生产镜像由本脚本从当前源码构建并推送到节点可达仓库；已有 CI 镜像时改 BUILD=false 并在 values 固定 tag/digest。
IMAGE=registry.example.com/aegisops
TAG=v1.0.0
FORM=standard
NAMESPACE=aegisops
BUILD=true
PUSH=true
STORE_DRIVER=mysql
BLOBS_BACKEND=s3
PERSIST_REPORTS=true
EXPOSE=none
# 外部服务由用户提供。本文件含凭据时 chmod 600，放源码目录之外。
# 首次导入会创建 <release>-mysql / <release>-s3；已有 Secret 始终复用，不会覆盖。
#MYSQL_DSN='aegisops:password@tcp(mysql:3306)/aegisops?parseTime=true&charset=utf8mb4&timeout=10s&readTimeout=30s&writeTimeout=30s'
#BLOBS_ENDPOINT=s3.internal:9000
#BLOBS_REGION=us-east-1
#BLOBS_BUCKET=aegisops
#BLOBS_ACCESS_KEY=your-access-key
#BLOBS_SECRET_KEY=your-secret-key
#BLOBS_USE_TLS=true
#BLOBS_PATH_STYLE=true
#BLOBS_CREATE_BUCKET=false
#PUBLIC_URL=https://aegisops.internal
#INGRESS_HOST=aegisops.internal
#INGRESS_CLASS=nginx
#STORAGE_CLASS=standard
#REPORT_STORAGE_SIZE=5Gi
#DATA_STORAGE_SIZE=5Gi
#IMAGE_WEB=ghcr.io/markguo123/aegisops-web
#IMAGE_PULL_SECRET=registry-auth
#IMAGE_PULL_POLICY=IfNotPresent
#ENABLE_WRITE=false
#OIDC_CA_FILE=/secure/idp-ca.pem
#OIDC_DISABLE_PKCE=false
#OIDC_ALLOW_MISSING_NONCE=false
#ALLOW_QUICKSTART_HTTP=false
# 完整参数和新 values 路径见部署手册。旧 --rotate/LOAD_TAR/ENABLE_MINIO 等不再支持；
# 使用用户管理的 Secret 轮换凭据、节点运行时导入镜像、官方中间件安装流程。
