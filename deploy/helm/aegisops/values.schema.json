{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "standard",
        "minimal"
      ]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30000,
          "maximum": 32767
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "driver": {
          "enum": [
            "mysql",
            "sqlite"
          ]
        }
      }
    },
    "blobs": {
      "type": "object",
      "properties": {
        "driver": {
          "enum": [
            "db",
            "dir",
            "s3",
            "off"
          ]
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "allowQuickstartHTTP": {
          "type": "boolean"
        },
        "allowLoopbackHTTP": {
          "type": "boolean"
        },
        "publicURL": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
